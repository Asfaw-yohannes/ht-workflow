#!/usr/bin/env python3
"""
VASP relaxation of one slab / adslab (generated from templates/vasp_relax.py.tmpl).
The relaxation is done inside VASP (IBRION/NSW); ASE only writes inputs and
reads the result. On success writes relaxed_pbe.e (energy) and final.traj.
"""
from ase.io import read, write
from ase.calculators.vasp import Vasp

STRUCTURE = "${structure_file}"
KPOINTS = ${kpoints}
VASP_SETTINGS = ${vasp_settings}
# Initial magnetic moments per element; spin polarisation is switched on
# only if the structure contains one of these elements.
MAGMOMS = ${magmoms}


def main():
    atoms = read(STRUCTURE)
    symbols = atoms.get_chemical_symbols()
    mags = [float(MAGMOMS.get(s, 0.0)) for s in symbols]
    spin = 2 if any(m != 0.0 for m in mags) else 1
    atoms.set_initial_magnetic_moments(mags)

    atoms.calc = Vasp(kpts=KPOINTS, ispin=spin, **VASP_SETTINGS)
    energy = atoms.get_potential_energy()

    write("final.traj", atoms)
    print("final energy", energy)
    # Written last: its presence marks the job as finished.
    with open("relaxed_pbe.e", "w") as fh:
        fh.write(f"{energy}\n")


if __name__ == "__main__":
    main()
